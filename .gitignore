# =============================================
# DGT Monorepo .gitignore
# =============================================

# =============================================
# Environment & Secrets
# =============================================
.env
.env.local
.env.*.local
!.env.example

# =============================================
# AI / LiteLLM Router
# =============================================
.ai/infra/litellm.log
.ai/infra/venv/
.ai/infra/__pycache__/

# =============================================
# Node.js & Build Artifacts
# =============================================
# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Dependency directories
node_modules/
jspm_packages/

# Coverage & testing
coverage
*.lcov
.nyc_output
.grunt

# Compiled binaries & caches
build/Release
*.tsbuildinfo
.npm
.eslintcache
.stylelintcache
.node_repl_history
*.tgz
.yarn-integrity
.cache
.parcel-cache

# =============================================
# Framework Specific
# =============================================
# Next.js
.next
out
build/
dgt-xyz-web/.next/
dgt-xyz-web/out/
dgt-xyz-web/build/
dgt-xyz-web/next-env.d.ts

# Sanity Studio
studio-dgt-xyz/.sanity/
studio-dgt-xyz/dist/
studio-dgt-xyz/.env

# Vercel / Turbo
.vercel/
.turbo/

# =============================================
# DGT Project-Specific Artifacts
# =============================================
# Temporary session files in issues
product/issues/**/output/turn-*/**/*.tmp
product/issues/**/output/turn-*/**/*.log

# =============================================
# OS & Editor
# =============================================
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/.history/
.idea/
*.iml

# =============================================
# Remaining legacy / general entries (kept for safety)
# =============================================
# (Your original entries that weren't covered above)
lib-cov
.lock-wscript
bower_components
web_modules/
.vuepress/dist
.temp
.cache
.svelte-kit/
**/.vitepress/dist
**/.vitepress/cache
.docusaurus
.serverless/
.fusebox/
.dynamodb/
.firebase/
.tern-port
.vscode-test
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
vite.config.js.timestamp-*
vite.config.ts.timestamp-*